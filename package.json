{
  "name": "mookup",
  "version": "2.0.22",
  "description": "Mookup desktop application",
  "author": "Team Mookup",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "electron": "node scripts/start-electron-local.mjs",
    "electron:dev": "node scripts/start-electron-local.mjs",
    "preelectron:pack": "node scripts/prepare-electron-package.mjs",
    "preelectron:dist": "node scripts/prepare-electron-package.mjs",
    "preelectron:publish": "node scripts/prepare-electron-package.mjs",
    "electron:pack": "electron-builder --dir",
    "electron:dist": "electron-builder",
    "electron:publish": "electron-builder --publish always",
    "electron:release": "npm run electron:publish",
    "prebuild": "node scripts/generate-version.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "admin:set": "node scripts/set-admin-claim.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@ai-sdk/mistral": "^3.0.40",
    "@ai-sdk/react": "^3.0.210",
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.4.0",
    "@capacitor/device": "^8.0.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@mintplex-labs/piper-tts-web": "^1.0.4",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.108.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vibrant/core": "^4.0.4",
    "@vibrant/generator": "^4.0.4",
    "@vibrant/image-browser": "^4.0.4",
    "@vibrant/quantizer-mmcq": "^4.0.4",
    "ai": "^6.0.208",
    "color-thief-browser": "^2.0.2",
    "edge-tts-universal": "^1.4.0",
    "electron-updater": "^6.8.9",
    "firebase": "^12.14.0",
    "firebase-admin": "14.2.0",
    "framer-motion": "^12.40.0",
    "get-windows": "^9.3.0",
    "gif-picker-react": "^2.0.0",
    "gittins": "^1.0.4",
    "highlight.js": "^11.11.1",
    "link-preview-js": "^4.0.3",
    "next": "16.2.7",
    "openai": "^6.44.0",
    "react": "19.2.4",
    "react-best-gradient-color-picker": "^3.0.14",
    "react-colorful": "^5.8.0",
    "react-copy-to-clipboard": "^5.1.1",
    "react-dom": "19.2.4",
    "react-firebase-hooks": "^5.1.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "y-indexeddb": "^9.0.12"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.mookup.app",
    "productName": "Mookup Client",
    "asar": true,
    "compression": "maximum",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "directories": {
      "app": ".electron-app",
      "buildResources": "public",
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "icon": "Logo.png",
    "win": {
      "icon": "Logo.ico",
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Mookup-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mookup Client",
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": ["dmg"],
      "artifactName": "Mookup-${version}.${ext}"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Network",
      "artifactName": "Mookup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Scribledecodage",
      "repo": "Mookup-Me",
      "releaseType": "release"
    }
  }
}
